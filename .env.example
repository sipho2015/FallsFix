# Public pages still work without database configuration.
# Windows local setup generates these values in ignored .env automatically.
# For an existing server, replace each placeholder with its own connection URL.
DATABASE_URL="postgresql://fallsfix_dev:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55433/fallsfix_dev"
# Separate disposable database used only by prisma migrate dev; never the main DB.
SHADOW_DATABASE_URL="postgresql://fallsfix_dev:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55433/fallsfix_shadow"
# Dedicated integration-test DB; its name must be fallsfix_test.
TEST_DATABASE_URL="postgresql://fallsfix_dev:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55433/fallsfix_test"
# Never place credentials in NEXT_PUBLIC_* variables: those are browser-visible.
# npm run auth:setup creates these local values without printing the secret.
BETTER_AUTH_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
BETTER_AUTH_URL="http://127.0.0.1:3000"
AUTH_EMAIL_TRANSPORT="file"
# Production requires HTTPS, smtp, and a trusted reverse proxy that OVERWRITES
# this header and prevents direct client access to the application server.
# AUTH_CLIENT_IP_HEADER="x-real-ip"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="REPLACE_WITH_SMTP_USER"
# SMTP_PASSWORD="REPLACE_WITH_SMTP_PASSWORD"
# SMTP_FROM="FallsFix <accounts@example.com>"
# Optional test-only variable: TEST_BASE_URL (defaults to http://127.0.0.1:3100).
# Canonical site origin for logo sharing previews (set HTTPS domain in production).
SITE_URL="http://127.0.0.1:3000"
# Optional separate Next build output for isolated tests/previews.
# NEXT_BUILD_DIR=".next-production"
# Optional PostgreSQL binaries for the local backup/restore drill.
# POSTGRES_BIN="C:/Program Files/PostgreSQL/18/bin"
# BACKEND_URL is a Vercel service binding. Do not configure it here or in Vercel.
# npm run dev starts both services with vercel dev -L and injects it automatically.
