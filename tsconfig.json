{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/frontend/*": [
        "./frontend/*"
      ],
      "@/shared/*": [
        "./frontend/shared/*"
      ],
      "@/backend/database/*": [
        "./database/client/*"
      ],
      "@/backend/*": [
        "./backend/*"
      ],
      "@/app/*": [
        "./frontend/src/app/*"
      ]
    }
  },
  "include": [
    "frontend/next-env.d.ts",
    "frontend/**/*.ts",
    "frontend/**/*.tsx",
    "backend/**/*.ts",
    "database/**/*.ts",
    "vercel/**/*.ts",
    "prisma.config.ts",
    "frontend/.next/types/**/*.ts",
    "frontend/.next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/.local",
    "database/generated",
    "frontend/.next-auth-test",
    "backend/.next",
    "backend/.next-*",
    "backend/next-env.d.ts",
    ".next",
    ".next-auth-test",
    ".next-production"
  ]
}
