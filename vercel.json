{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs",
      "installCommand": "npm ci --prefix .. --include=dev",
      "buildCommand": "npm --prefix .. run release:check && npm --prefix .. run build:frontend",
      "devCommand": "npm --prefix .. run dev:frontend",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    },
    "backend": {
      "root": "backend",
      "framework": "nextjs",
      "installCommand": "npm ci --prefix .. --include=dev",
      "buildCommand": "npm --prefix .. run release:check && npm --prefix .. run build:backend",
      "devCommand": "npm --prefix .. run dev:backend"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
